# =============================================================================
# ComplyGCC (placeholder name) — environment template
# -----------------------------------------------------------------------------
# This is the CANONICAL/target configuration: MySQL 8 + Redis, per SPEC.md §4.
# Copy to `.env` and adjust for your machine. The committed `.env` in this repo
# is a LOCAL boot profile (file/sync drivers) so the app runs before MySQL/Redis
# are stood up in milestone 2 — see README "Local development".
#
# The product name is a placeholder (SPEC.md §14). It is NOT hardcoded anywhere;
# it is read from APP_NAME via config('app.name'). Change it here only.
# =============================================================================

APP_NAME="Novex Trust"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Internationalisation — English + Arabic (RTL) are first-class (SPEC.md §10).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database — MySQL 8 (SPEC.md §4). Stand up the service in milestone 2.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=complygcc
DB_USERNAME=complygcc
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Cache / queue / session — Redis (SPEC.md §4: Redis for cache + queue).
# Queue workers run under Supervisor in production (SPEC.md §11).
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# phpredis (PECL ext) is preferred in production; install predis as a fallback
# if the extension is unavailable. Redis is provisioned in milestone 2.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail — alerts channel (SPEC.md §8). `log` driver until SMTP is configured.
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Alert channels + WhatsApp (Twilio). Set COMPLIANCE_ALERT_CHANNELS=email,whatsapp
# to also send WhatsApp (recipients need a phone on file). TWILIO_WHATSAPP_FROM
# like "whatsapp:+9715XXXXXXXX"; set TWILIO_WHATSAPP_CONTENT_SID to an approved
# Twilio Content template (single {{1}} variable) for production messages.
# -----------------------------------------------------------------------------
COMPLIANCE_ALERT_CHANNELS=email
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# -----------------------------------------------------------------------------
# Object storage — encrypted document vault (SPEC.md §10). S3-compatible.
# Region is CONFIG (residency-flexible). Avoid me-central-1 / me-south-1 until
# stable; pick a currently-stable region (SPEC.md §4 hosting caveat). Wired in
# milestone 5 (vault); left blank here.
# -----------------------------------------------------------------------------
# S3 object storage (document vault). Decided region: Singapore (ap-southeast-1).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Encrypted document vault (SPEC.md §8/§10).
# VAULT_DISK_DRIVER: 'local' (dev) or 's3' (production — uses the AWS_* values).
# VAULT_KMS_DRIVER: 'local' (master key below) — swap for a managed KMS later.
# VAULT_MASTER_KEY: 32 bytes, base64. Generate with `php artisan vault:key`.
# Keep this OUT of the data store / backups (it is the crown-jewel key).
# -----------------------------------------------------------------------------
VAULT_DISK=vault
VAULT_DISK_DRIVER=local
VAULT_KMS_DRIVER=local
VAULT_MASTER_KEY=

VITE_APP_NAME="${APP_NAME}"
