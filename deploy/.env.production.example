# =============================================================================
# ComplyGCC — PRODUCTION env template (Ubuntu 22.04 deployment).
# Copy to backend/.env on the server and fill in the blanks. Then:
#   php artisan key:generate
#   php artisan vault:key
# Keep this file (and the real .env) OUT of version control.
# =============================================================================

APP_NAME="Novex Trust"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database: MySQL 8 (created by provision.sh) -----------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=complygcc
DB_USERNAME=complygcc
DB_PASSWORD=

# --- Cache / queue / session: Redis -----------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (alerts) — set real SMTP credentials ------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Encrypted document vault (SPEC.md §10) — S3, Singapore -----------------
# Vault stored in S3 (ap-southeast-1). Documents are envelope-encrypted BEFORE
# upload, so S3 only ever holds ciphertext. The master key must live outside the
# data store / backups — generate with `php artisan vault:key`.
VAULT_DISK=vault
VAULT_DISK_DRIVER=s3
VAULT_KMS_DRIVER=local
VAULT_MASTER_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Extraction provider (zero-retention) — stub until a vendor is set -------
EXTRACTION_DRIVER=stub
